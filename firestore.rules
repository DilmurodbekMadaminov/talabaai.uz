rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Security Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'admin@student.ai' ||
          request.auth.token.email.lower() == 'dilnuramadaminova06@gmail.com'
        )) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 1. Subjects & Quiz Question Banks
    match /subjects/{subjectId} {
      allow read: if true;
      allow create, update: if isValidId(subjectId);
      allow delete: if isValidId(subjectId);
    }

    // 2. User Personal Data, Chats & Wallets
    match /user_data/{userId} {
      allow read, write: if isValidId(userId);
    }

    // 3. Registered User Accounts
    match /users/{userId} {
      allow read: if isValidId(userId);
      allow create, update: if isValidId(userId);
      allow delete: if isValidId(userId) && (isAdmin() || !isSignedIn());
    }

    // 4. WebAuthn Hardware Biometric Credentials
    match /webauthn_credentials/{credId} {
      allow read, write: if isValidId(credId);
    }

    // 5. System Notifications
    match /notifications/{notifId} {
      allow read: if true;
      allow write: if isValidId(notifId);
    }

    // 6. Student Marketplace Orders & Freelance Jobs
    match /orders/{orderId} {
      allow read: if true;
      allow create, update, delete: if isValidId(orderId);
    }

    match /jobs/{jobId} {
      allow read: if true;
      allow create, update, delete: if isValidId(jobId);
    }

    // 7. Promocodes & System Section Lock Configurations
    match /promocodes/{promoId} {
      allow read: if true;
      allow write: if isValidId(promoId);
    }

    match /section_locks/{lockId} {
      allow read: if true;
      allow write: if isValidId(lockId);
    }

    // 8. Cybersecurity Threat Logs
    match /security_logs/{logId} {
      allow read, write: if isValidId(logId);
    }

    // Catch-all Default-Deny Security Guard
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
