{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "talabaai-uz",
  "main": "worker.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
